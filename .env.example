# Port yang dialokasikan di Pterodactyl (otomatis diisi Pterodactyl via SERVER_PORT)
SERVER_PORT=8080

# (Opsional) Jika ingin bot di Pterodactyl otomatis push data.json ke GitHub:
# Isi dengan GitHub Personal Access Token (PAT) Anda
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_REPO=dhitxyz/liga1-api

# Interval pengecekan (detik)
FAST_POLL_SEC=60
IDLE_POLL_SEC=900
